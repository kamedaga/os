{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "Linux"
    },
    "display": {
        "showErrors": true,
        "noBuffer": true
    },
    "modules": [
        "title",
        "separator",
        "os",
        {
            "type": "kernel",
            "format": "{sysname} {release}"
        },
        "shell",
        "terminal",
        "cpu",
        "memory",
        "uptime"
    ]
}
