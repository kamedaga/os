{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "Linux"
    },
    "display": {
        "showErrors": true,
        "noBuffer": true,
        "key": {
            "width": 15
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        {
            "type": "kernel",
            "format": "{sysname} {release} ({arch}, page {page-size})"
        },
        "uptime",
        "shell",
        "terminal",
        "terminalsize",
        {
            "type": "datetime",
            "key": "Date/Time",
            "format": "{year}-{month-pretty}-{day-pretty} {hour-pretty}:{minute-pretty}:{second-pretty} UTC{offset-from-utc}"
        },
        "locale",
        {
            "type": "cpu",
            "format": "{name} ({cores-logical} threads)"
        },
        "memory",
        "swap",
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/",
            "format": "{size-used} / {size-total} ({filesystem})"
        },
        {
            "type": "packages",
            "key": "Packages",
            "format": "{apk} (apk)"
        },
        "processes",
        "dns",
        "colors"
    ]
}
