#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

color_enabled() {
  if [ -n "${NO_COLOR:-}" ] || [ "${PACGO_COLOR:-}" = "never" ]; then
    return 1
  fi
  if [ "${PACGO_COLOR:-}" = "always" ]; then
    return 0
  fi
  [ -t 1 ] && [ "${TERM:-}" != "dumb" ]
}

task() {
  if color_enabled; then
    printf '\n\033[34m\033[1m> Task\033[0m \033[36m\033[1m:%s\033[0m\n' "$1"
  else
    printf '\n> Task :%s\n' "$1"
  fi
}

if [ "${PACGO_NIX_DEVELOP:-}" != "1" ]; then
  task "nix:develop"
  exec nix develop "$root" --command "$root/pacgo" "$@"
fi

bin="$root/.artifacts/bin/pacgo"
mkdir -p "$(dirname "$bin")"

needs_build=0
if [ ! -x "$bin" ]; then
  needs_build=1
else
  while IFS= read -r path; do
    if [ "$path" -nt "$bin" ]; then
      needs_build=1
      break
    fi
  done < <(find "$root/pack" -type f \( -name '*.go' -o -name go.mod -o -name go.sum \))
fi

if [ "$needs_build" = "1" ]; then
  task "pacgo:compile"
  (cd "$root/pack" && go build -o "$bin" ./cmd/pacgo)
fi

exec "$bin" "$@"
