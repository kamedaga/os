# Build upstream wpa_supplicant without source patches. Linux owns nl80211,
# EAPOL, key installation and roaming; netd owns IP configuration.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_UNIX=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_OPENSSL_LOAD_LEGACY=y
CONFIG_GETRANDOM=y
CONFIG_IEEE80211W=y
CONFIG_SAE=y
CONFIG_SAE_PK=y
CONFIG_OWE=y
CONFIG_WNM=y
CONFIG_IEEE80211R=y
CONFIG_SHA256=y
CONFIG_SHA384=y
CONFIG_ECC=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_PKCS12=y
CONFIG_DEBUG_FILE=y
CONFIG_MATCH_IFACE=y
